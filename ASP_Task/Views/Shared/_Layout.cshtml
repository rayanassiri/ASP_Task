@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP_Task Executive Suite</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Font & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ASP_Task.styles.css" asp-append-version="true" />

    <style>
            :root {
                /* نظام ألوان النخبة - Executive Elite Palette */
                --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
                --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                --sidebar-bg: rgba(255, 255, 255, 0.94);
                --topbar-bg: rgba(255, 255, 255, 0.85);
                --body-bg: #f4f6f9;
                --card-bg: #ffffff;
                --primary-color: #4f46e5;
                --text-main: #090d16;
                --text-muted: #64748b;
                --border-color: rgba(226, 232, 240, 0.8);
                --border-glow: rgba(79, 70, 229, 0.15);
                --sidebar-width: 285px;
                --transition-smooth: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            }

            body {
                font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                background-color: var(--body-bg);
                color: var(--text-main);
                min-height: 100vh;
                margin: 0;
                display: flex;
                overflow-x: hidden;
                letter-spacing: -0.015em;
                -webkit-font-smoothing: antialiased;
                /* خلفية شبكية هندسية دقيقة تمنح طابعاً عالمياً فخماً */
                background-image: radial-gradient(var(--border-color) 1px, transparent 1px);
                background-size: 24px 24px;
            }

            /* --- ULTRA SIDEBAR --- */
            .sidebar {
                width: var(--sidebar-width);
                background-color: var(--sidebar-bg);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-right: 1px solid var(--border-color);
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 1050;
                display: flex;
                flex-direction: column;
                transition: var(--transition-smooth);
                box-shadow: 10px 0 30px rgba(0, 0, 0, 0.02);
            }

            .sidebar-brand {
                padding: 1.75rem 1.75rem;
                display: flex;
                align-items: center;
                gap: 1rem;
                text-decoration: none;
                font-weight: 800;
                font-size: 1.35rem;
                background: var(--primary-gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                border-bottom: 1px solid var(--border-color);
                letter-spacing: -0.03em;
            }

            .brand-icon-wrapper {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: var(--primary-gradient);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
                -webkit-text-fill-color: white;
            }

            .sidebar-menu {
                padding: 1.5rem 1.15rem;
                list-style: none;
                margin: 0;
                flex: 1;
                overflow-y: auto;
            }

                .sidebar-menu::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-menu::-webkit-scrollbar-thumb {
                    background: #cbd5e1;
                    border-radius: 4px;
                }

            .sidebar-header-label {
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: #94a3b8;
                font-weight: 800;
                padding: 1rem 0.85rem 0.5rem;
            }

            .sidebar-item {
                margin-bottom: 0.35rem;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 0.95rem;
                padding: 0.8rem 1.1rem;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.925rem;
                border-radius: 0.85rem;
                transition: var(--transition-smooth);
                position: relative;
            }

                .sidebar-link i {
                    font-size: 1.1rem;
                    width: 24px;
                    text-align: center;
                    color: #94a3b8;
                    transition: var(--transition-smooth);
                }

                .sidebar-link:hover {
                    color: var(--primary-color);
                    background-color: rgba(99, 102, 241, 0.06);
                    transform: translateX(4px);
                }

                    .sidebar-link:hover i {
                        color: var(--primary-color);
                    }

                .sidebar-link.active {
                    color: white !important;
                    background: var(--primary-gradient);
                    font-weight: 700;
                    box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
                }

                    .sidebar-link.active i {
                        color: white !important;
                    }

            /* --- WRAPPER & TOPBAR --- */
            .wrapper {
                flex: 1;
                margin-left: var(--sidebar-width);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                transition: var(--transition-smooth);
            }

            .topbar {
                height: 80px;
                background-color: var(--topbar-bg);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid var(--border-color);
                padding: 0 2.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 1040;
            }

            .topbar-search {
                position: relative;
                width: 320px;
            }

                .topbar-search input {
                    background-color: #f1f5f9;
                    border: 1px solid var(--border-color);
                    border-radius: 1.5rem;
                    padding: 0.6rem 1rem 0.6rem 2.6rem;
                    font-size: 0.875rem;
                    color: var(--text-main);
                    transition: var(--transition-smooth);
                }

                    .topbar-search input:focus {
                        background-color: #ffffff;
                        border-color: var(--primary-color);
                        box-shadow: 0 0 0 4px var(--border-glow);
                        outline: none;
                    }

                .topbar-search i {
                    position: absolute;
                    left: 1rem;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                    font-size: 0.875rem;
                }

            /* User Profile Button */
            .user-dropdown-btn {
                background: #ffffff;
                border: 1px solid var(--border-color);
                padding: 0.35rem 0.9rem 0.35rem 0.35rem;
                border-radius: 2rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                text-decoration: none;
                transition: var(--transition-smooth);
                box-shadow: 0 2px 5px rgba(0,0,0,0.01);
            }

                .user-dropdown-btn:hover {
                    border-color: var(--primary-color);
                    box-shadow: 0 5px 15px rgba(79, 70, 229, 0.08);
                    transform: translateY(-1px);
                }

            .user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--primary-gradient);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 0.9rem;
                box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
            }

            /* --- MAIN CONTENT AREA --- */
            .main-content {
                flex: 1;
                padding: 2.5rem;
            }

            /* --- EXECUTIVE FOOTER --- */
            .footer-custom {
                background-color: rgba(255, 255, 255, 0.8);
                backdrop-filter: blur(10px);
                border-top: 1px solid var(--border-color);
                color: var(--text-muted);
                padding: 1.5rem 2.5rem;
                font-size: 0.875rem;
            }

            .footer-link {
                color: var(--text-muted);
                text-decoration: none;
                transition: var(--transition-smooth);
                font-weight: 500;
            }

                .footer-link:hover {
                    color: var(--primary-color);
                }

            /* Dropdown Menu الفاخر */
            .dropdown-menu {
                border-radius: 1rem;
                padding: 0.5rem;
                border: 1px solid var(--border-color);
                box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.1);
                background-color: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(20px);
                animation: fadeInDrop 0.2s ease;
            }

            @@keyframes fadeInDrop {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .dropdown-item {
                border-radius: 0.75rem;
                padding: 0.65rem 1rem;
                font-weight: 600;
                font-size: 0.875rem;
                transition: var(--transition-smooth);
                color: var(--text-main);
            }

                .dropdown-item:hover {
                    background-color: rgba(99, 102, 241, 0.08);
                    color: var(--primary-color);
                    transform: translateX(3px);
                }

            /* Responsive Sidebar */
            @@media (max-width: 991.98px) {
                .sidebar {
                    transform: translateX(-100%);
                }

                    .sidebar.show {
                        transform: translateX(0);
                    }

                .wrapper {
                    margin-left: 0;
                }

                .topbar {
                    padding: 0 1.25rem;
                }

                .main-content {
                    padding: 1.75rem 1.25rem;
                }
            }
    </style>
</head>
<body>
    @{
        var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    }

    <!-- ================= ULTRA SIDEBAR ================= -->
    <aside class="sidebar" id="appSidebar">
        <!-- Brand Logo -->
        <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <div class="brand-icon-wrapper">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <span>ASP_Task</span>
        </a>

        <!-- Sidebar Navigation Menu -->
        <ul class="sidebar-menu">
            <div class="sidebar-header-label">Core Modules</div>

            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Categories" asp-action="Index">
                    <i class="fa-solid fa-folder"></i>
                    <span>Categories</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Products" asp-action="Index">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Products</span>
                </a>
            </li>

            <div class="sidebar-header-label mt-3">Business & Operations</div>

            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Customers" asp-action="Index">
                    <i class="fa-solid fa-users-rectangle"></i>
                    <span>Customers</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Orders" asp-action="Index">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Orders</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a class="sidebar-link" asp-area="" asp-controller="Suppliers" asp-action="Index">
                    <i class="fa-solid fa-truck-field"></i>
                    <span>Suppliers</span>
                </a>
            </li>

            @if (!string.IsNullOrEmpty(username))
            {
                <div class="sidebar-header-label mt-3">Administration</div>
                <li class="sidebar-item">
                    <a class="sidebar-link" asp-controller="Users" asp-action="Index">
                        <i class="fa-solid fa-users-gear"></i>
                        <span>Manage Users</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a class="sidebar-link" asp-controller="Roles" asp-action="Index">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Roles & Permissions</span>
                    </a>
                </li>
            }
        </ul>
    </aside>

    <!-- ================= WRAPPER ================= -->
    <div class="wrapper">

        <!-- Topbar -->
        <header class="topbar">
            <div class="d-flex align-items-center gap-3">
                <!-- Mobile Toggle Button -->
                <button class="btn btn-light d-lg-none rounded-circle shadow-sm border" type="button" id="sidebarToggle" style="width: 42px; height: 42px;">
                    <i class="fa-solid fa-bars-staggered"></i>
                </button>

                <!-- Topbar Search -->
                <div class="topbar-search d-none d-md-block">
                    <i class="fa-solid fa-search"></i>
                    <input type="text" class="form-control" placeholder="Search tasks, products, entities...">
                </div>
            </div>

            <!-- Profile & Actions -->
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(username))
                {
                    <div class="dropdown">
                        <a href="#" class="user-dropdown-btn dropdown-toggle" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar">
                                @username.Substring(0, 1).ToUpper()
                            </div>
                            <div class="d-none d-sm-block text-start pe-2">
                                <div class="fw-bold text-dark" style="font-size: 0.875rem; line-height: 1.2;">@username</div>
                                <div class="text-muted" style="font-size: 0.7rem; font-weight: 600;">Administrator</div>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end mt-2" aria-labelledby="adminDropdown">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-users-gear me-2 text-primary"></i> Manage Users</a></li>
                            <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index"><i class="fa-solid fa-shield-halved me-2 text-primary"></i> Roles & Permissions</a></li>
                            <li><hr class="dropdown-divider my-2 border-light"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Accounts" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn px-4 py-2 rounded-pill fw-bold text-white shadow-sm" style="background: var(--primary-gradient); border: none; font-size: 0.875rem;" asp-controller="Accounts" asp-action="Login">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Login
                    </a>
                }
            </div>
        </header>

        <!-- Main View Body -->
        <div class="main-content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <!-- Footer -->
        <footer class="footer-custom">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <div>
                    &copy; 2026 <strong style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">ASP_Task</strong>. All rights reserved.
                </div>
                <div class="d-flex gap-4 align-items-center">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a>
                    <span class="text-muted">&bull;</span>
                    <a href="#" class="footer-link">Support Center</a>
                </div>
            </div>
        </footer>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sidebar Toggle Script for Mobile -->
    <script>
            $(document).ready(function () {
                $('#sidebarToggle').on('click', function () {
                    $('#appSidebar').toggleClass('show');
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>