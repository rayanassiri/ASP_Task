@model ASP_Task.Models.RolePermissionsViewModel

@{
    ViewData["Title"] = "تعيين الصلاحيات";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold text-primary mb-0">
                    <i class="fa-solid fa-user-shield me-2"></i>تعيين الصلاحيات
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3 p-2 bg-light rounded">
                    <span class="fw-bold text-dark">الدور: </span>
                    <span class="badge bg-primary fs-6">@Model.RoleName</span>
                </div>

                <form asp-action="AssignPermissions" method="post">
                    <input type="hidden" asp-for="RoleId" />
                    <input type="hidden" asp-for="RoleName" />

                    <div class="my-4">
                        @for (int i = 0; i < Model.Permissions.Count; i++)
                        {
                            <div class="form-check mb-3">
                                <input type="hidden" asp-for="Permissions[i].Name" />
                                <input type="hidden" asp-for="Permissions[i].DisplayName" />
                                <input class="form-check-input" type="checkbox" asp-for="Permissions[i].IsSelected" id="perm_@i" />
                                <label class="form-check-label fw-semibold me-2" for="perm_@i">
                                    @Model.Permissions[i].DisplayName
                                </label>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-1"></i> حفظ الصلاحيات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>