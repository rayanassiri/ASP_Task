@model IEnumerable<ASP_Task.Models.Role>

@{
    ViewData["Title"] = "الأدوار والصلاحيات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary mb-0">
        <i class="fa-solid fa-shield-halved me-2"></i>أدوار المستخدمين
    </h2>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> إضافة دور جديد
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th># المعرف</th>
                    <th>اسم الدور</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">
                                <span class="badge bg-primary fs-6">@item.RoleName</span>
                            </td>
                            <td class="text-end">
                                <!-- زر تعيين الصلاحيات -->
                                <a asp-action="AssignPermissions" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="تعيين الصلاحيات">
                                    <i class="fa-solid fa-user-shield"></i>
                                </a>
                                <!-- زر التعديل -->
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="تعديل">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <!-- زر الحذف -->
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">لا توجد أدوار معرفة حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>