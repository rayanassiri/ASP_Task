@model ASP_Task.Models.Role

@{
    ViewData["Title"] = "إضافة دور جديد";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold text-primary mb-0">
                    <i class="fa-solid fa-shield-cat me-2"></i>إضافة دور جديد
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label fw-semibold">اسم الدور</label>
                        <input asp-for="RoleName" class="form-control" placeholder="مثال: مسؤول، مدير، موظف" />
                        <span asp-validation-for="RoleName" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-1"></i> حفظ الدور
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}