@using ASP_Task.Dtos
@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "قائمة المنتجات";
    int count = 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>إدارة المنتجات</h2>
        <a asp-action="Create" class="btn btn-success">+ إضافة منتج جديد</a>
    </div>

    <table class="table table-bordered table-striped text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>الصورة</th>
                <th>اسم المنتج</th>
                <th>السعر</th>
                <th>الكمية بالحجم/العدد</th>
                <th>القسم</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(count++)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageURL))
                        {
                            <img src="@item.ImageURL" width="50" height="50" style="object-fit:cover; border-radius:8px;" />
                        }
                        else
                        {
                            <span class="badge bg-secondary">لا توجد صورة</span>
                        }
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.StockQuantity</td>
                    <td>@item.CategoryName</td>
                </tr>
            }
        </tbody>
    </table>
</div>