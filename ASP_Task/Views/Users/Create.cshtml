@model ASP_Task.Models.User

@{
    ViewData["Title"] = "إضافة مستخدم جديد";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold text-primary mb-0">
                    <i class="fa-solid fa-user-plus me-2"></i>إضافة مستخدم جديد
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold">اسم المستخدم</label>
                        <input asp-for="Username" class="form-control" placeholder="أدخل اسم المستخدم" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">الاسم الكامل</label>
                        <input asp-for="FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="أدخل البريد الإلكتروني" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HashPassword" class="form-label fw-semibold">كلمة المرور</label>
                        <input asp-for="HashPassword" type="password" class="form-control" placeholder="أدخل كلمة المرور" />
                        <span asp-validation-for="HashPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-right me-1"></i> العودة للقائمة
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-save me-1"></i> حفظ المستخدم
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}